{
  "id": "P8SlaWatchdog01",
  "name": "SLA Watchdog",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "e94e340e-a4e6-47db-a689-72ee2d8593cd",
      "name": "Every Demo Minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-760, -100]
    },
    {
      "parameters": {},
      "id": "2d20f9f7-cc47-4ae4-a4c8-a138b94db7c9",
      "name": "Manual Watchdog Run",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-760, 100]
    },
    {
      "parameters": {
        "url": "={{ $env.BACKEND_BASE_URL + '/api/v1/actions/due' }}",
        "options": {
          "splitIntoItems": true
        }
      },
      "id": "899546ba-ff84-4df8-9ab5-655b384291fd",
      "name": "Get Due Actions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-520, 0],
      "retryOnFail": false
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_BASE_URL + '/api/v1/deliveries/attempts' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { case_public_id: $json.case_public_id, delivery_type: $json.delivery_type, recipient_id: $json.recipient_id, idempotency_key: $json.delivery_idempotency_key, allow_retry: false } }}",
        "options": {}
      },
      "id": "86489201-1398-49f2-94b2-e8ceba092fc7",
      "name": "Start Due Delivery",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-280, 0],
      "retryOnFail": false
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "b293b254-ab1d-4909-9428-e9dc74fddf5a",
              "leftValue": "={{ $json.delivery_completed }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "9855ac3e-346a-43ff-b894-f4cf86ea099d",
      "name": "Delivery Already Complete?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-40, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "d58759e0-2d46-4bfb-a292-7c72a2429bd4",
              "leftValue": "={{ $json.status }}",
              "rightValue": "PENDING",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b9b131cb-fdbb-45a6-88cc-7ca30a682e58",
      "name": "Attempt Is Pending?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [180, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_BASE_URL + '/api/v1/demo/deliveries' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { delivery_type: $json.delivery_type, recipient_id: $json.recipient_id, idempotency_key: $json.idempotency_key, attempt_number: $json.attempt_number, simulate_failure: $env.SLA_DEMO_FORCE_FAILURE === 'true' } }}",
        "options": {}
      },
      "id": "64048165-ce28-45e2-b93f-a830e72c7d46",
      "name": "Execute Local SLA Transport",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 100],
      "retryOnFail": false
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_BASE_URL + '/api/v1/deliveries/' + $json.idempotency_key + '/attempts/' + $json.attempt_number + '/result' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { status: $json.status, external_message_id: $json.external_message_id, error_message: $json.error_message } }}",
        "options": {}
      },
      "id": "32f062a7-ccfb-4e36-b6bb-b29346ed2af8",
      "name": "Report SLA Delivery Result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 100],
      "retryOnFail": false
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "7e418b91-bd8c-4f25-b5c1-6d46358d7648",
              "leftValue": "={{ $json.status }}",
              "rightValue": "SUCCEEDED",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a6343703-5fa2-483b-b31f-1e895fc07b19",
      "name": "Transport Succeeded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [900, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_BASE_URL + '/api/v1/actions/' + $('Get Due Actions').item.json.case_public_id + '/ack' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { action_type: $('Get Due Actions').item.json.action_type, level: $('Get Due Actions').item.json.level } }}",
        "options": {}
      },
      "id": "daff532b-d7bd-4e56-ae15-2f3734e4aadc",
      "name": "Acknowledge Successful SLA Action",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1140, -40],
      "retryOnFail": false
    }
  ],
  "pinData": {},
  "connections": {
